# Copy to .env (Bun loads it automatically). Never commit real secrets.
CLAWAPI_ENV=development
CLAWAPI_HOST=127.0.0.1
CLAWAPI_PORT=8080
CLAWAPI_DATABASE_PATH=./data/clawapi.db
CLAWAPI_LOG_LEVEL=info
# json | pretty (defaults: pretty in development, json in production)
# CLAWAPI_LOG_FORMAT=pretty
CLAWAPI_CONSOLE_ENABLED=true

# Sessions
CLAWAPI_SESSION_IDLE_MINUTES=60
CLAWAPI_SESSION_MAX_HOURS=12
# Secure cookies need HTTPS. Defaults to true when CLAWAPI_ENV=production.
# CLAWAPI_COOKIE_SECURE=true
# Optional pre-chosen initial setup token (otherwise generated into data/setup-token).
# CLAWAPI_SETUP_TOKEN=

# Background health check interval
CLAWAPI_HEALTH_INTERVAL_SECONDS=30

# Encryption key for stored provider credentials (32 bytes, base64 or hex).
# Required in production; generate with: openssl rand -base64 32
# CLAWAPI_SECRET_KEY=
# CLAWAPI_SECRET_KEY_FILE=/run/secrets/clawapi_key
# Background provider health checks (0 = off)
CLAWAPI_PROVIDER_HEALTH_INTERVAL_SECONDS=300
