{
  "name": "@enterprise-ui/react",
  "version": "0.1.0",
  "description": "A Fiori-inspired enterprise React component library: design tokens, themes, components, layouts and enterprise patterns.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./tokens.css": {
      "types": "./dist/tokens.css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "react",
    "typescript",
    "design-system",
    "enterprise",
    "components",
    "fiori"
  ],
  "scripts": {
    "dev": "npm run docs:api && vite --config docs/vite.config.ts",
    "build": "npm run build:lib && npm run build:docs",
    "build:lib": "vite build && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "build:docs": "npm run docs:api && vite build --config docs/vite.config.ts",
    "preview": "vite preview --config docs/vite.config.ts --strictPort",
    "docs:api": "node scripts/extract-api.mjs",
    "typecheck": "npm run docs:api && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "check": "npm run typecheck && npm run lint && npm run test",
    "docs:screenshots": "node scripts/readme-screenshots.mjs",
    "test:e2e:phase3": "playwright test --config playwright.phase3.config.ts",
    "test:consumer": "npm run build:lib && node scripts/check-consumer.mjs",
    "test:e2e:docs": "playwright test --config playwright.docs-audit.config.ts",
    "docs:check": "npm run docs:api && node scripts/check-doc-links.mjs && npm run build:lib && node scripts/check-api-declarations.mjs"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "dependencies": {
    "lucide-react": "^1.63.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
